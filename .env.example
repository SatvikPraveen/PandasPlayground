# Copy to .env to override defaults. All variables are optional.

# Project directory overrides (default: paths relative to the repository root)
PANDASPLAYGROUND_ROOT=
PANDASPLAYGROUND_DATA=
PANDASPLAYGROUND_ASSETS=
PANDASPLAYGROUND_EXPORTS=
PANDASPLAYGROUND_RUNS=

# Hypothesis test profile: "dev" (fast) or "ci" (more examples)
HYPOTHESIS_PROFILE=dev

# Streamlit
STREAMLIT_SERVER_PORT=8501
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
